# Backend
APP_ENV=dev
APP_PORT=8000

# Postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=smartscrape
POSTGRES_USER=smartscrape
POSTGRES_PASSWORD=smartscrape_pwd

# Redis
REDIS_URL=redis://redis:6379/0

# Scraping
SCRAPER_USER_AGENT=SmartScrapeBot/0.1 (+https://example.com)
SCRAPER_MAX_DEPTH=2
SCRAPER_REQUEST_DELAY_SECONDS=1.0
SCRAPER_REQUEST_TIMEOUT_SECONDS=15.0
SCRAPER_MAX_PAGES_PER_DOMAIN=60

# --- OpenAI / ChatGPT ---
# Clé API (obligatoire pour activer l'IA)
OPENAI_API_KEY=sk-xxxx

# Modèle par défaut (petit, pas cher, très bon pour ce cas)
OPENAI_MODEL=gpt-4.1-mini

# Activer / désactiver l'IA (1 = on, 0 = off)
OPENAI_ENABLE=1

# Limites de génération
OPENAI_MAX_TOKENS=2000          # sortie LLM
LLM_MAX_CHARS=20000            # taille max de texte envoyé au LLM
