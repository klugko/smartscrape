# --------------------
# Backend
# --------------------
APP_ENV=prod
APP_PORT=8000

# --------------------
# PostgreSQL 
# --------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=smartscrape
POSTGRES_USER=smartscrape
POSTGRES_PASSWORD=change_me_strong_pwd

# --------------------
# Redis (dans Docker)
# --------------------
REDIS_URL=redis://redis:6379/0

# --------------------
# Scraping
# --------------------
SCRAPER_USER_AGENT=SmartScrapeBot/0.1 
SCRAPER_MAX_DEPTH=2
SCRAPER_REQUEST_DELAY_SECONDS=1.0
SCRAPER_REQUEST_TIMEOUT_SECONDS=15.0
SCRAPER_MAX_PAGES_PER_DOMAIN=60

# --------------------
# OpenAI / LLM
# --------------------
OPENAI_API_KEY=sk-xxxx
OPENAI_MODEL=gpt-4.1-mini
OPENAI_ENABLE=1

# Limites de génération
OPENAI_MAX_TOKENS=2000
LLM_MAX_CHARS=20000
